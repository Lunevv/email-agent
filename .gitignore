# Боевые данные аккаунта — никогда не коммитятся и не пакуются в релиз.
# Со звёздочкой, чтобы переименование (projects.live.off на время съёмки
# скриншотов) не вынесло папку из-под игнора.
projects.live*/

# Приватные выгрузки внутри любого проекта (на случай, если их всё-таки положат)
projects/*/private/
projects.live*/*/private/

# Системное
.DS_Store
node_modules/
*.log

# Логи запусков по расписанию
logs/

# Локальные превью дашбордов
preview/

# Питоновский кэш
__pycache__/
*.pyc
